// Replace the default fonts if replacement files exist.
// GM2026 parity: GMS1.4 treated font_add() size as PIXEL height; GM2026 renders it as
// POINTS (x96/72 = 1.333x bigger). Scale all TTF sizes by 0.75 to match the reference.
var _fscale = 0.75;
ini_open("lang/fonts/sizes.ini");

if(file_exists("lang/fonts/04b09.ttf")) {
    fontGUI = font_add( "lang/fonts/04b09.ttf", ini_read_real("Sizes", "04b09_(large)", 16) * _fscale, false, false, 32, 255);
    fontSubScr = font_add( "lang/fonts/04b09.ttf", ini_read_real("Sizes", "04b09_(small)", 8) * _fscale, false, false, 32, 255);
    GUIOffset          = ini_read_real("Offsets", "04b09_(large)_offset", 0);
    subScrHeaderOffset = ini_read_real("Offsets", "04b09_(small)_offset", 0);
}

if(file_exists("lang/fonts/acknowledge_tt_brk.ttf")) {
    fontGUI2 = font_add( "lang/fonts/acknowledge_tt_brk.ttf", ini_read_real("Sizes", "Acknowledge_TT_BRK", 13) * _fscale, false, false, 32, 255);
}

if(file_exists("lang/fonts/uni_05_53.ttf")) {
    fontMenuSmall = font_add( "lang/fonts/uni_05_53.ttf", ini_read_real("Sizes", "uni_05_53", 8) * _fscale, false, false, 32, 255);
}

if(file_exists("lang/fonts/04b24.ttf")) {
    fontMenuTiny = font_add( "lang/fonts/04b24.ttf", ini_read_real("Sizes", "04b24", 16) * _fscale, false, false, 32, 255);
    subScrItemOffset = ini_read_real("Offsets", "04b24_offset", -6);
}

