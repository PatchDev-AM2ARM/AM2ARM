// This list holds the widths for all the rooms and is vital for widescreen transitions. 
// If rooms are added (or, presumably, removed) it must be recreated.
room_width_map = ds_map_create();
// GM2026 fix: this map was shipped as a serialized ds_map blob keyed by GMS1.4's numeric
// room ids. GM2026 renumbers all rooms, so every lookup returned the WRONG room's width —
// breaking widescreen narrow-room handling and transition positioning (rooms shown at full
// 426px width, doorless transitions triggering early). Rebuild it from live room data at
// boot instead; immune to any future renumbering. (~395 rooms, trivial cost, done once.)
var _rm = room_first;
while (_rm != -1) {
    var _info = room_get_info(_rm, false, false, false, false, false);
    ds_map_add(room_width_map, _rm, _info.width);
    _rm = room_next(_rm);
}


/* */
/*  */


// --- Controller mapping fix (GM2026 Linux port) ---
// Pads like the Razer Wolverine V3 aren't in GameMaker's built-in SDL controller DB,
// so gamepad_is_connected() stays false and input never binds. Register a generic
// Xbox-style mapping for every enumerated device by its GUID so the pad is recognised.
if (os_type == os_linux) {
    for (var _gp = 0; _gp < gamepad_get_device_count(); _gp += 1) {
        var _guid = gamepad_get_guid(_gp);
        if (is_string(_guid) && string_length(_guid) >= 32) {
            gamepad_test_mapping(_gp, _guid
                + ",AM2R Controller,"
                + "a:b0,b:b1,x:b2,y:b3,"
                + "back:b6,guide:b8,start:b7,"
                + "leftstick:b9,rightstick:b10,"
                + "leftshoulder:b4,rightshoulder:b5,"
                + "dpup:h0.1,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,"
                + "leftx:a0,lefty:a1,rightx:a3,righty:a4,"
                + "lefttrigger:a2,righttrigger:a5,"
                + "platform:Linux,");
        }
    }
}

dual_init();

