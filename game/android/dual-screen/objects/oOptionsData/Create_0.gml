global.curropt = 0;
lastitem = global.android_app ? 6 : 2;
active = 0;
alarm[0] = 5;
found1 = 0;
found2 = 0;
found3 = 0;
foundu = 0;
ingame = instance_exists(oSS_Control);
result_pending = 0;
result_action = "";
result_ok = 0;
result_files = 0;
event_user(0);
with (oSS_Fg) op_text1 = get_text("Misc", "DataMenu");
if (global.android_app) tip[0] = get_text("Misc", "BackupSaves_Tip");
else tip[0] = port_caption("Copy your saves to the saves/backup folder for safekeeping");
if (ingame) tip[1] = get_text("Misc", "RestoreIngame_Tip");
else if (global.android_app) tip[1] = get_text("Misc", "RestoreSaves_Tip");
else tip[1] = port_caption("Load saves from the saves/backup folder. Overwrites current saves");
tip[2] = port_caption("Choose the folder your sync service uses.");
tip[3] = global.am2r_sync.message;
tip[4] = port_caption("Choose between conflicting progress at the title menu.");
tip[5] = port_caption("Turn off sync. Existing saves and shared files stay intact.");
tip[lastitem] = get_text("GlobalOptions", "Exit_Tip");
global.tiptext = tip[global.curropt];
