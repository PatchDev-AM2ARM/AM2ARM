<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity android:name="${YYAndroidPackageName}.RunnerActivity">
            <!-- The launcher enters through the display router instead of moving the game. -->
            <intent-filter tools:node="removeAll" />
        </activity>
        <activity android:name="${YYAndroidPackageName}.AM2RDisplayEntry"
                  android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
                  android:exported="true" android:noHistory="true"
                  android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                ${YYAndroidExtraCategories}
            </intent-filter>
        </activity>
    </application>
</manifest>
